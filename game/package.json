{
  "name": "dao-den-long",
  "version": "1.0.0",
  "description": "Đảo Đèn Lồng — deterministic 3D adventure game",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "headless": "node src/headless/cli.js",
    "game": "node src/launcher/cli.js",
    "bench": "node src/bench/cli.js",
    "soak": "node --expose-gc src/soak/cli.js",
    "demo": "node src/demo/cli.js",
    "test": "node --test",
    "verify:regression": "npm test && node scripts/verify-determinism.js",
    "verify:performance": "node scripts/verify-performance.js",
    "verify": "npm run verify:regression && npm run verify:performance"
  },
  "dependencies": {
    "three": "0.181.2"
  },
  "devDependencies": {
    "vite": "7.3.8"
  }
}
